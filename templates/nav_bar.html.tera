<nav class="navbar">
    <div class="navbar-inner">
        <div class="navbar-links">
            <a class="nav-link {% if current_page == 'index' %}active{% endif %}" href="/">Home</a>
            <a class="nav-link {% if current_page == 'movie_list' %}active{% endif %}" href="/movies">Movies</a>
            <a class="nav-link {% if current_page == 'tv_list' %}active{% endif %}" href="/tv_list">TV Shows</a>
            <a class="nav-link {% if current_page == 'categories' %}active{% endif %}"
                href="/category_explainer">Categories</a>
            <a class="nav-link {% if current_page == 'about' %}active{% endif %}" href="/about">About</a>
        </div>
        <div class="navbar-auth" id="navbarAuth">
            <a class="nav-link login-btn" href="/login">Login</a>
        </div>
    </div>
</nav>

<style>
    .navbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: #0d1425;
        border-bottom: 1px solid #374151;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        margin-bottom: 1rem;
    }

    .navbar-inner {
        max-width: 1000px;
        margin: 0 auto;
        padding: 10px 16px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
    }

    .navbar-links {
        justify-self: center;
        display: inline-flex;
        gap: 18px;
        grid-column: 2;
    }

    .navbar-auth {
        justify-self: end;
        grid-column: 3;
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .login-btn {
        background: rgba(96, 165, 250, 0.2);
        border: 1px solid #60a5fa;
        font-weight: 500;
        padding: 8px 12px;
    }

    .login-btn:hover {
        background: rgba(96, 165, 250, 0.3);
        color: #93c5fd;
    }

    .nav-link {
        color: #ffffff;
        text-decoration: none;
        padding: 8px 8px;
        border-radius: 8px;
        transition: color 0.15s ease, background 0.15s ease;
    }

    .nav-link:hover {
        color: #60a5fa;
        background: rgba(96, 165, 250, 0.1);
    }

    .nav-link.active {
        color: #60a5fa;
        background: rgba(96, 165, 250, 0.15);
        font-weight: 600;
    }

    .profile-link {
        background: rgba(96, 165, 250, 0.2);
        border: 1px solid #60a5fa;
        font-weight: 500;
        padding: 8px 12px;
    }

    .profile-link:hover {
        background: rgba(96, 165, 250, 0.3);
        color: #93c5fd;
    }

    .logout-btn {
        background: rgba(239, 68, 68, 0.2);
        border: 1px solid #ef4444;
        color: #fca5a5;
        font-weight: 500;
        padding: 8px 12px;
        cursor: pointer;
        border-radius: 8px;
        transition: color 0.15s ease, background 0.15s ease;
    }

    .logout-btn:hover {
        background: rgba(239, 68, 68, 0.3);
        color: #fecaca;
    }

    @media (max-width: 640px) {
        .navbar-inner {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .navbar-links {
            justify-self: center;
            flex-wrap: wrap;
            gap: 10px;
            grid-column: auto;
        }

        .navbar-auth {
            grid-column: auto;
            margin-top: 10px;
            justify-content: center;
        }
    }
</style>

<script>
    // Check if user is logged in and update navbar accordingly
    function updateNavbarAuthState() {
        const token = localStorage.getItem('auth_token');
        const navbarAuth = document.getElementById('navbarAuth');

        if (token) {
            // User is logged in
            navbarAuth.innerHTML = `
                <a class="nav-link profile-link" href="/profile">Profile</a>
                <button class="logout-btn" onclick="logout()">Logout</button>
            `;
        } else {
            // User is not logged in
            navbarAuth.innerHTML = `
                <a class="nav-link login-btn" href="/login">Login</a>
            `;
        }
    }

    // Logout function
    function logout() {
        localStorage.removeItem('auth_token');
        updateNavbarAuthState();
        window.location.href = '/';
    }

    // Update navbar on page load
    document.addEventListener('DOMContentLoaded', updateNavbarAuthState);

    // Also update navbar when returning from login page (in case login was successful)
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            updateNavbarAuthState();
        }
    });
</script>
